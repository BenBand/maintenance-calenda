# Dependencies
node_modules/

# Environment files - these hold DATABASE_URL credentials, JWT_SECRET,
# AUDIT_IP_SALT and every other secret. Only the .example templates are
# committed, so keep the negations at the bottom of this block.
.env
.env.*
!.env.example
!.env.*.example
.envrc

# Build outputs
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

