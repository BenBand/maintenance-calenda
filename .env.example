# Environment variables template
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit the actual .env file

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/maintenance_calendar

# JWT - generate a strong secret with: openssl rand -base64 64
JWT_SECRET=replace-with-strong-secret-from-openssl-rand-base64-64-minimum-32-chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# Timezone the analytics reporting periods and calendar buckets align to
APP_TIMEZONE=Africa/Lusaka

# Maximum PostgreSQL connection pool size
DB_POOL_MAX=10

# Server
PORT=5000
NODE_ENV=development
BCRYPT_SALT_ROUNDS=12

# Salt for hashing IP addresses in audit logs (privacy)
# Generate a random one; the server refuses to start with the placeholder.
AUDIT_IP_SALT=generate-a-random-salt-here

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3001

# Frontend (Vite reads these from frontend/.env)
VITE_API_URL=http://localhost:5000
VITE_DEV_PORT=3001
