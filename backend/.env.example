# Maintenance Calendar - Environment Variables
#
# The server validates these at boot and refuses to start while JWT_SECRET,
# AUDIT_IP_SALT or CLIENT_ORIGIN are still the placeholder values below.
# Generate secrets with: openssl rand -base64 64

PORT=5000
JWT_SECRET=replace-with-a-strong-64-char-secret-generated-via-openssl-rand-base64-64
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
DATABASE_URL=postgresql://user:password@localhost:5432/maintenance_db
NODE_ENV=development

# Timezone the analytics reporting periods and calendar buckets are aligned to
APP_TIMEZONE=Africa/Lusaka

# Maximum PostgreSQL connection pool size
DB_POOL_MAX=10

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3001

BCRYPT_SALT_ROUNDS=12

# Salt for hashing IP addresses in audit logs (privacy)
AUDIT_IP_SALT=generate-a-random-salt-here
