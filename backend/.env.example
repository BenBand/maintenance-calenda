# Maintenance Calendar - Environment Variables

PORT=5000
JWT_SECRET=replace-with-a-strong-64-char-secret-generated-via-openssl-rand-base64-64
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
DATABASE_URL=postgresql://user:password@localhost:5432/maintenance_db
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3001
BCRYPT_SALT_ROUNDS=10

# Salt for hashing IP addresses in audit logs (privacy)
AUDIT_IP_SALT=generate-a-random-salt-here

# Admin account - set these to create the initial admin via `npm run seed`
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
